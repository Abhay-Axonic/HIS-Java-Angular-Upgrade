{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read(*)",
      "Grep(*)",
      "Glob(*)",
      "Write(docs/**)",
      "Edit(docs/**)",
      "Write(legacy/**)",
      "Edit(legacy/**)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(mvn *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push *)",
      "Bash(rm *)",
      "Bash(curl *)"
    ]
  }
}
