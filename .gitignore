legacy-codewhale-attempt/
legacy/his-maven-jars/

# Editor backup files (e.g. Vim/Emacs auto-save copies) -- must never be tracked,
# since they silently duplicate whatever secrets/state the source file had at save time.
*.java~

# macOS Finder metadata
.DS_Store

# Compiled TypeScript emits must never be tracked — the tsc build writes .js
# beside the .ts sources; they are build artifacts (2026-08-13: 22 were
# tracked and removed). Sources are the .ts; the .js regenerates on build.
new/src/**/*.js

# untracked dev credentials (get_dev_token.py)
tools/.dev_credentials
tools/.token_cache.json

# overnight-survey live session (never commit a credential)
tools/.survey_cookie.json
