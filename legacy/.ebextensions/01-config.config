option_settings:
  - namespace: aws:elasticbeanstalk:environment:proxy
    option_name: ProxyServer
    value: nginx
  - namespace: aws:elasticbeanstalk:container:tomcat:jvmoptions
    option_name: JVMOptions
    value: "-XX:+UseG1GC -XX:+UseStringDeduplication -XX:MaxRAMPercentage=75"
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: JAVA_HOME
    value: "/usr/lib/jvm/java-17-amazon-corretto"
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: PATH
    value: "/usr/lib/jvm/java-17-amazon-corretto/bin:$PATH"

# Use container_commands to ensure server.xml is updated on every deployment
container_commands:
  add-swap-space:
    command: "/bin/bash .ebextensions/scripts/add-swap-space.sh"
  01_copy_server_xml:
    command: "sudo cp .ebextensions/tomcat9/server.xml /etc/tomcat9/server.xml"
  02_restart_tomcat:
    command: "sudo systemctl restart tomcat9"
    

