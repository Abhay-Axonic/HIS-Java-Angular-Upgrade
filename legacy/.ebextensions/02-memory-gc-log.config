files:
  "/opt/eb-monitor/run_gc.sh":
    mode: "0755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      LOG_FILE="/var/log/memory_gc.log"
      THRESHOLD=80
      MEM_USAGE=$(free | awk '/Mem:/ {printf "%.0f", $3/$2 * 100}')
      TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

      if [ "$MEM_USAGE" -ge "$THRESHOLD" ]; then
          echo "$TIMESTAMP: Memory usage ${MEM_USAGE}% >= ${THRESHOLD}%, running GC..." | tee -a $LOG_FILE
          PID=$(pgrep -f 'java.*tomcat')
          if [ -n "$PID" ]; then
              sudo jcmd $PID GC.heap_info | tee -a $LOG_FILE
              sudo jcmd $PID GC.run | tee -a $LOG_FILE
              sudo jcmd $PID GC.heap_info | tee -a $LOG_FILE
              echo "$TIMESTAMP: GC completed for PID $PID" | tee -a $LOG_FILE
          else
              echo "$TIMESTAMP: Tomcat process not found!" | tee -a $LOG_FILE
          fi
      else
          echo "$TIMESTAMP: Memory usage ${MEM_USAGE}% < ${THRESHOLD}%, no action." | tee -a $LOG_FILE
      fi

  "/etc/systemd/system/memory-gc.service":
    mode: "0644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Run GC when memory usage is high

      [Service]
      Type=oneshot
      ExecStart=/opt/eb-monitor/run_gc.sh

  "/etc/systemd/system/memory-gc.timer":
    mode: "0644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Run memory GC every 5 minutes

      [Timer]
      OnBootSec=1min
      OnUnitActiveSec=5min

      [Install]
      WantedBy=timers.target

commands:
  setup_memory_gc:
    command: |
      systemctl daemon-reload
      systemctl enable --now memory-gc.timer
      touch /var/log/memory_gc.log
      chmod 644 /var/log/memory_gc.log
