-- DROP FUNCTION public.process_complaints_by_encounter(int4);

CREATE OR REPLACE FUNCTION public.process_complaints_by_encounter(p_encounter_id integer DEFAULT NULL::integer)
 RETURNS void
 LANGUAGE plpgsql
AS $function$
DECLARE
    rec RECORD;
    v_json JSONB;
    v_complaint JSONB;
    v_complaint_desc TEXT;
    v_remark TEXT;
    v_patient_id INT;
    v_encounter_id INT;
    v_unit_id INT;
    v_org_id INT;
    v_admission_id INT := NULL;
    v_icpc_id INT;
    v_icpc_system_id INT;
    v_complaint_list TEXT := '';
    v_inserted BOOLEAN := FALSE;
BEGIN
    FOR rec IN
        SELECT * FROM public.t_patient_casesheet_details
        WHERE (p_encounter_id IS NULL AND (complaint_status IS NULL OR complaint_status != 'done'))
           OR (p_encounter_id IS NOT NULL AND encounter_id = p_encounter_id)
    LOOP
        BEGIN
            v_json := rec.json_message::jsonb;
            v_unit_id := rec.unit_id;
            v_org_id := rec.org_id;
            v_encounter_id := rec.encounter_id;

            -- Get patient info
            SELECT tem.patient_id INTO v_patient_id
            FROM opd.t_encounter_master tem
            WHERE tem.encounter_id = v_encounter_id;

            -- Get latest admission ID if available
            SELECT ta.admission_id INTO v_admission_id
            FROM adt.t_admission ta
            WHERE ta.patient_id = v_patient_id
            ORDER BY ta.admission_id DESC
            LIMIT 1;

            -- Loop through complaints array if exists
            FOR v_complaint IN SELECT * FROM jsonb_array_elements(v_json -> 'complaints')
            LOOP
                v_complaint_desc := TRIM(v_complaint->>'complaintDesc');
                v_remark := COALESCE(TRIM(v_complaint->>'remark'), '');

                IF v_complaint_desc IS NOT NULL AND v_complaint_desc <> '' THEN
                    -- Search ICPC case-insensitive
                    SELECT icpc_id, icpc_system_id INTO v_icpc_id, v_icpc_system_id
                    FROM emr.m_icpc
                    WHERE LOWER(icpc_desc) = LOWER(v_complaint_desc)
                    LIMIT 1;

                    -- If not found, insert new ICPC record with icpc_code = NULL and status 'A'
                    IF v_icpc_id IS NULL THEN
                        INSERT INTO emr.m_icpc (icpc_system_id, icpc_code, icpc_desc, status)
                        VALUES (NULL, NULL, v_complaint_desc, 'A')
                        RETURNING icpc_id, icpc_system_id INTO v_icpc_id, v_icpc_system_id;
                    END IF;

                    -- Insert complaint mapping
                    INSERT INTO patient.t_complaint_appo_mapper
                    (encounter_id, status, created_by, cerated_date, updated_by, updated_date,
                     unit_id, organization_id, diagnosis_id, remark, role_id,
                     is_reviewed_flag, icpc_system_id, icpc_code_text, patient_id)
                    VALUES
                    (v_encounter_id, 'A', 1, now(), 1, now(),
                     v_unit_id, v_org_id, v_icpc_id, v_remark, 2,
                     'N', v_icpc_system_id, v_complaint_desc, v_patient_id);

                    v_complaint_list := v_complaint_list || v_complaint_desc || ', ';
                    v_inserted := TRUE;
                END IF;
            END LOOP;

            -- Clean trailing comma and space
            IF RIGHT(v_complaint_list, 2) = ', ' THEN
                v_complaint_list := LEFT(v_complaint_list, LENGTH(v_complaint_list) - 2);
            END IF;

            -- Insert into log
            INSERT INTO public.t_complaint_mapper_fun_log (
                encounter_id, complaint_list, status, error_msg
            ) VALUES (
                v_encounter_id, v_complaint_list,
                CASE WHEN v_inserted THEN 'done' ELSE 'not done' END,
                NULL
            );

            -- Mark complaint_status as done
            UPDATE public.t_patient_casesheet_details
            SET complaint_status = 'done'
            WHERE id = rec.id;

        EXCEPTION WHEN OTHERS THEN
            INSERT INTO public.t_complaint_mapper_fun_log (
                encounter_id, complaint_list, status, error_msg
            ) VALUES (
                v_encounter_id, v_complaint_list, 'error', SQLERRM
            );
        END;
    END LOOP;
END;
$function$
;



