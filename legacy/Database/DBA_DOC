-- DROP FUNCTION public.process_habit_by_encounter(int4);

CREATE OR REPLACE FUNCTION public.process_habit_by_encounter(p_encounter_id integer DEFAULT NULL::integer)
 RETURNS void
 LANGUAGE plpgsql
AS $function$
DECLARE
    rec RECORD;
    v_json JSONB;
    v_habit JSONB;
    v_habit_desc TEXT;
    v_habit_type_desc TEXT;
    v_remark TEXT;
    v_habit_id INT;
    v_habit_type_id INT;
    v_patient_id INT;
    v_admission_id INT := NULL;
    v_appointment_id INT := NULL;
    v_unit_id INT;
    v_org_id INT;
    v_habit_ids TEXT := '';
    v_inserted BOOLEAN := FALSE;
BEGIN
    FOR rec IN
        SELECT * FROM public.t_patient_casesheet_details
        WHERE (p_encounter_id IS NULL AND (patient_map_status IS NULL OR patient_map_status != 'done'))
           OR (p_encounter_id IS NOT NULL AND encounter_id = p_encounter_id)
    LOOP
        BEGIN
            v_json := rec.json_message::jsonb;
            v_unit_id := rec.unit_id;
            v_org_id := rec.org_id;

            -- Get patient and appointment info
            SELECT tem.patient_id, tem.appointment_id INTO v_patient_id, v_appointment_id
            FROM opd.t_encounter_master tem
            WHERE tem.encounter_id = rec.encounter_id;

            -- Get admission id (optional)
            SELECT ta.admission_id INTO v_admission_id
            FROM adt.t_admission ta
            WHERE ta.patient_id = v_patient_id
            ORDER BY ta.admission_id DESC
            LIMIT 1;

            -- Loop through habit array if exists
            FOR v_habit IN SELECT * FROM jsonb_array_elements(v_json -> 'habbits')
            LOOP
                v_habit_desc := TRIM(LOWER(v_habit->>'habitDesc'));
                v_habit_type_desc := TRIM(LOWER(v_habit->>'habitTypeDesc'));
                v_remark := v_habit->>'remark';

                -- Insert into habit_type_master if not exists
                SELECT habit_type_id INTO v_habit_type_id
                FROM emr.m_habit_type_master
                WHERE TRIM(LOWER(habit_type_desc)) = v_habit_type_desc
                LIMIT 1;

                IF v_habit_type_id IS NULL THEN
                    INSERT INTO emr.m_habit_type_master (
                        habit_type_desc, status, created_by, created_date, marathi_habit_type_desc, updated_by, updated_date, unit_id, organization_id
                    ) VALUES (
                        INITCAP(v_habit_type_desc), 'A', 1, now(), NULL, 1, now(), v_unit_id, v_org_id
                    ) RETURNING habit_type_id INTO v_habit_type_id;
                END IF;

                -- Insert into habit_master if not exists
                SELECT habit_id INTO v_habit_id
                FROM emr.m_habit_master
                WHERE TRIM(LOWER(habit_desc)) = v_habit_desc
                LIMIT 1;

                IF v_habit_id IS NULL THEN
                    INSERT INTO emr.m_habit_master (
                        habit_desc, status, created_date, created_by, updated_by, updated_date, marathi_habit_desc, unit_id, organization_id
                    ) VALUES (
                        INITCAP(v_habit_desc), 'A', now(), 1, 1, now(), NULL, v_unit_id, v_org_id
                    ) RETURNING habit_id INTO v_habit_id;
                END IF;

                -- Insert into patient habit details
                INSERT INTO patient.t_patient_habit_details (
                    patient_id, habit_id, habit_type_id, remark,
                    cigarettes_per_day, years_smoked, gms_per_day, years_used,
                    mls_per_day, frequency, pack_year, type_of_exercise,
                    created_by, created_date, updated_by, updated_date, status,
                    unit_id, organization_id, encounter_id, admission_id
                ) VALUES (
                    v_patient_id, v_habit_id, v_habit_type_id, v_remark,
                    COALESCE((v_habit->>'cigarettesPerDay')::INT, 0),
                    COALESCE((v_habit->>'yearsSmoked')::INT, 0),
                    COALESCE((v_habit->>'gmsPerDay')::INT, 0),
                    COALESCE((v_habit->>'yearsUsed')::INT, 0),
                    COALESCE((v_habit->>'mlsPerDay')::INT, 0),
                    v_habit->>'frequency',
                    COALESCE((v_habit->>'packYear')::FLOAT, 0),
                    v_habit->>'typeOfExercise',
                    1, now(), 1, now(), 'A',
                    v_unit_id, v_org_id, rec.encounter_id, v_admission_id
                );

                v_habit_ids := v_habit_ids || v_habit_id || ',';
                v_inserted := TRUE;
            END LOOP;

            -- Clean up trailing comma
            IF RIGHT(v_habit_ids, 1) = ',' THEN
                v_habit_ids := LEFT(v_habit_ids, LENGTH(v_habit_ids) - 1);
            END IF;

            -- Log result
            INSERT INTO public.t_habit_mapper_fun_log (
                encounter_id, habit_ids, status, error_msg
            ) VALUES (
                rec.encounter_id, v_habit_ids,
                CASE WHEN v_inserted THEN 'done' ELSE 'not done' END, NULL
            );

            -- Update source table
            UPDATE public.t_patient_casesheet_details
            SET habit_status = 'done'
            WHERE id = rec.id;

        EXCEPTION WHEN OTHERS THEN
            INSERT INTO public.t_habit_mapper_fun_log (
                encounter_id, habit_ids, status, error_msg
            ) VALUES (
                rec.encounter_id, v_habit_ids, 'error', SQLERRM
            );
        END;
    END LOOP;
END;
$function$
;


