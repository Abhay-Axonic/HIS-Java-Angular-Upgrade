CREATE OR REPLACE FUNCTION public.process_diagnosis_by_encounter(p_encounter_id bigint DEFAULT NULL::bigint)
 RETURNS void
 LANGUAGE plpgsql
AS $function$
DECLARE
    rec RECORD;
    v_json JSONB;
    v_diag JSONB;
    v_diag_code TEXT;
    v_diag_desc TEXT;
    v_patient_id BIGINT;
    v_encounter_id BIGINT;
    v_unit_id INT;
    v_org_id INT;
    v_admission_id BIGINT := NULL;
    v_diagnosis_id BIGINT;
    v_inserted BOOLEAN := FALSE;
    v_diag_list TEXT := '';
BEGIN
    FOR rec IN
        SELECT * FROM public.t_patient_casesheet_details
        WHERE (p_encounter_id IS NULL AND (diagnosis_status IS NULL OR diagnosis_status != 'done'))
           OR (p_encounter_id IS NOT NULL AND encounter_id = p_encounter_id)
    LOOP
        BEGIN
            v_json := rec.json_message::jsonb;
            v_unit_id := rec.unit_id;
            v_org_id := rec.org_id;
            v_encounter_id := rec.encounter_id;

            -- Get patient ID
            SELECT tem.patient_id INTO v_patient_id
            FROM opd.t_encounter_master tem
            WHERE tem.encounter_id = v_encounter_id;

            -- Get latest admission ID if available
            SELECT ta.admission_id INTO v_admission_id
            FROM adt.t_admission ta
            WHERE ta.patient_id = v_patient_id
            ORDER BY ta.admission_id DESC
            LIMIT 1;

            -- Process diagnosis array
            FOR v_diag IN SELECT * FROM jsonb_array_elements(v_json -> 'diagnosis')
            LOOP
                v_diag_code := TRIM(v_diag->>'code');
                v_diag_desc := TRIM(v_diag->>'diagnosisDesc');

                IF v_diag_code IS NOT NULL AND v_diag_code <> '' THEN
                    -- Get or insert diagnosis_id
                    SELECT diagnosis_id INTO v_diagnosis_id
                    FROM emr.m_diagnosis_master
                    WHERE code = v_diag_code
                    LIMIT 1;

                    IF NOT FOUND THEN
                        INSERT INTO emr.m_diagnosis_master (
                            diagnosis_desc, status, created_date, created_by, code, diagnosis_name,
                            updated_by, updated_date, unit_id, organization_id, is_notifiable, is_comorbidity
                        ) VALUES (
                            v_diag_desc, 'A', NOW(), 1, v_diag_code, v_diag_desc,
                            1, NOW(), v_unit_id, v_org_id, 'N', 'N'
                        ) RETURNING diagnosis_id INTO v_diagnosis_id;
                    END IF;

                    INSERT INTO patient.t_patient_diagnosis_appo_mapper (
                        organization_id, unit_id, encounter_id, patient_id, diagnosis_id,
                        type, remark, created_by, created_date, updated_by, updated_date, status,
                        admission_id, is_diagnosis_cancel, diagnosis_type, is_deleted, is_resolved, resolved_date
                    ) VALUES (
                        v_org_id, v_unit_id, v_encounter_id, v_patient_id, v_diagnosis_id,
                        2, TRIM(v_diag->>'remarks'), 1, NOW(), 1, NOW(), 'A',
                        v_admission_id, 'N', 1, 'N', 'N', NOW()
                    );

                    v_diag_list := v_diag_list || v_diag_desc || ', ';
                    v_inserted := TRUE;
                END IF;
            END LOOP;

            -- Remove trailing comma
            IF RIGHT(v_diag_list, 2) = ', ' THEN
                v_diag_list := LEFT(v_diag_list, LENGTH(v_diag_list) - 2);
            END IF;

            INSERT INTO public.t_diagnosis_mapper_fun_log (
                encounter_id, diagnosis_list, status, error_msg
            ) VALUES (
                v_encounter_id, v_diag_list,
                CASE WHEN v_inserted THEN 'done' ELSE 'not done' END,
                NULL
            );

            -- Update status in source table
            UPDATE public.t_patient_casesheet_details
            SET diagnosis_status = 'done'
            WHERE id = rec.id;

        EXCEPTION WHEN OTHERS THEN
            INSERT INTO public.t_diagnosis_mapper_fun_log (
                encounter_id, diagnosis_list, status, error_msg
            ) VALUES (
                v_encounter_id, v_diag_list, 'error', SQLERRM
            );
        END;
    END LOOP;
END;
$function$
;


