-- DROP FUNCTION public.process_medical_history_by_encounter(int4);

CREATE OR REPLACE FUNCTION public.process_medical_history_by_encounter(p_encounter_id integer DEFAULT NULL::integer)
 RETURNS void
 LANGUAGE plpgsql
AS $function$
DECLARE
    rec RECORD;
    v_json JSONB;
    v_medhist JSONB;
    v_code TEXT;
    v_diag_desc TEXT;
    v_remark TEXT;
    v_patient_id INT;
    v_encounter_id INT;
    v_unit_id INT;
    v_org_id INT;
    v_admission_id INT := NULL;
    v_diagnosis_id INT;
    v_inserted BOOLEAN := FALSE;
    v_medhist_list TEXT := '';
BEGIN
    FOR rec IN
        SELECT * FROM public.t_patient_casesheet_details
        WHERE (p_encounter_id IS NULL AND (medical_history_status IS NULL OR medical_history_status != 'done'))
           OR (p_encounter_id IS NOT NULL AND encounter_id = p_encounter_id)
    LOOP
        BEGIN
            v_json := rec.json_message::jsonb;
            v_unit_id := rec.unit_id;
            v_org_id := rec.org_id;
            v_encounter_id := rec.encounter_id;

            -- Get patient ID from encounter master
            SELECT tem.patient_id INTO v_patient_id
            FROM opd.t_encounter_master tem
            WHERE tem.encounter_id = v_encounter_id;

            -- Get latest admission ID if any
            SELECT ta.admission_id INTO v_admission_id
            FROM adt.t_admission ta
            WHERE ta.patient_id = v_patient_id
            ORDER BY ta.admission_id DESC
            LIMIT 1;

            -- Loop through medicalHistory array if exists
            FOR v_medhist IN SELECT * FROM jsonb_array_elements(v_json -> 'medicalHistory')
            LOOP
                v_code := TRIM(v_medhist->>'code');
                v_diag_desc := TRIM(v_medhist->>'diagnosisDesc');
                v_remark := COALESCE(TRIM(v_medhist->>'remarks'), '');

                IF v_code IS NOT NULL AND v_code <> '' THEN
                    -- Check if diagnosis exists in master
                    SELECT diagnosis_id INTO v_diagnosis_id
                    FROM emr.m_diagnosis_master
                    WHERE code = v_code AND unit_id = v_unit_id AND organization_id = v_org_id
                    LIMIT 1;

                    -- Insert diagnosis if not found
                    IF v_diagnosis_id IS NULL THEN
                        INSERT INTO emr.m_diagnosis_master (
                            diagnosis_desc, status, created_date, created_by, code, diagnosis_name, updated_by, updated_date, unit_id, organization_id, is_notifiable, is_comorbidity
                        ) VALUES (
                            v_diag_desc, 'A', now(), 1, v_code, v_diag_desc, 1, now(), v_unit_id, v_org_id, 'N', 'N'
                        )
                        RETURNING diagnosis_id INTO v_diagnosis_id;
                    END IF;

                    -- Insert into patient medical history
                    INSERT INTO patient.t_patient_medical_history (
                        patient_id, diagnosis_id, remark, created_date, created_by, status, updated_by, updated_date,
                        unit_id, organization_id, is_no_significant_status, encounter_id, admission_id
                    ) VALUES (
                        v_patient_id, v_diagnosis_id, v_remark, now(), 1, 'A', 1, now(),
                        v_unit_id, v_org_id, 'N', v_encounter_id, v_admission_id
                    );

                    v_medhist_list := v_medhist_list || v_diag_desc || ', ';
                    v_inserted := TRUE;
                END IF;
            END LOOP;

            -- Clean trailing comma and space
            IF RIGHT(v_medhist_list, 2) = ', ' THEN
                v_medhist_list := LEFT(v_medhist_list, LENGTH(v_medhist_list) - 2);
            END IF;

            -- Insert into log
            INSERT INTO public.t_medical_history_fun_log (
                encounter_id, medical_history_list, status, error_msg
            ) VALUES (
                v_encounter_id, v_medhist_list,
                CASE WHEN v_inserted THEN 'done' ELSE 'not done' END,
                NULL
            );

            -- Update medical_history_status in casesheet details
            UPDATE public.t_patient_casesheet_details
            SET medical_history_status = 'done'
            WHERE id = rec.id;

        EXCEPTION WHEN OTHERS THEN
            INSERT INTO public.t_medical_history_fun_log (
                encounter_id, medical_history_list, status, error_msg
            ) VALUES (
                v_encounter_id, v_medhist_list, 'error', SQLERRM
            );
        END;
    END LOOP;
END;
$function$
;



