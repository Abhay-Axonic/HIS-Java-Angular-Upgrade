-- DROP FUNCTION public.process_advice_by_encounter(int4);

CREATE OR REPLACE FUNCTION public.process_advice_by_encounter(p_encounter_id integer DEFAULT NULL::integer)
 RETURNS void
 LANGUAGE plpgsql
AS $function$
DECLARE
    rec RECORD;
    v_json JSONB;
    v_advice JSONB;
    v_advice_desc TEXT;
    v_patient_id INT;
    v_encounter_id INT;
    v_unit_id INT;
    v_org_id INT;
    v_admission_id INT := NULL;
    v_appointment_id INT := NULL;
    v_inserted BOOLEAN := FALSE;
    v_advice_list TEXT := '';
    v_advice_id INT;
BEGIN
    FOR rec IN
        SELECT * FROM public.t_patient_casesheet_details
        WHERE (p_encounter_id IS NULL AND (patient_map_status IS NULL OR patient_map_status != 'done'))
           OR (p_encounter_id IS NOT NULL AND encounter_id = p_encounter_id)
    LOOP
        BEGIN
            v_json := rec.json_message::jsonb;
            v_unit_id := rec.unit_id;
            v_org_id := rec.org_id;
            v_encounter_id := rec.encounter_id;

            -- Get patient info
            SELECT tem.patient_id INTO v_patient_id
            FROM opd.t_encounter_master tem
            WHERE tem.encounter_id = v_encounter_id;

            -- Get latest admission ID if available
            SELECT ta.admission_id INTO v_admission_id
            FROM adt.t_admission ta
            WHERE ta.patient_id = v_patient_id
            ORDER BY ta.admission_id DESC
            LIMIT 1;

            -- Get appointment_id from encounter master
            SELECT appointment_id INTO v_appointment_id
            FROM opd.t_encounter_master
            WHERE encounter_id = v_encounter_id
            LIMIT 1;

            v_inserted := FALSE;
            v_advice_list := '';

            -- Loop through advice array if exists
            FOR v_advice IN SELECT * FROM jsonb_array_elements(v_json -> 'adviceData')
            LOOP
                v_advice_desc := TRIM(v_advice->>'adviceDesc');

                IF v_advice_desc IS NOT NULL AND v_advice_desc <> '' THEN
                    -- Check if advice exists in emr.m_advice_master
                    SELECT advice_id INTO v_advice_id
                    FROM emr.m_advice_master
                    WHERE advice_desc = v_advice_desc
                      AND unit_id = v_unit_id
                      AND organization_id = v_org_id
                    LIMIT 1;

                    -- If not found, insert new advice and get advice_id
                    IF NOT FOUND THEN
                        INSERT INTO emr.m_advice_master
                        (advice_desc, status, created_by, created_date, updated_by, updated_date, marathi_advice_desc, unit_id, organization_id)
                        VALUES
                        (v_advice_desc, 'A'::char, 1, now(), 1, now(), NULL, v_unit_id, v_org_id)
                        RETURNING advice_id INTO v_advice_id;
                    END IF;

                    -- Insert into observation table
                    INSERT INTO opd.t_observation (
                        unit_id, organization_id, patient_id, encounter_id,
                        status, created_date, created_by, updated_date, updated_by,
                        doctor_id, admission_id, observation_desc, cov_template_id
                    ) VALUES (
                        v_unit_id, v_org_id, v_patient_id, v_encounter_id,
                        'A', now(), 1, now(), 1,
                        1, v_admission_id, v_advice_desc, NULL
                    );

                    -- Insert into patient.t_advice_appo_mapper
                    INSERT INTO patient.t_advice_appo_mapper (
                        advice_id, appointment_id, status, created_by, created_date,
                        description, updated_by, updated_date, unit_id, organization_id
                    ) VALUES (
                        v_advice_id,
                        v_appointment_id,
                        'A'::char,
                        1,
                        NOW(),
                        v_advice_desc,
                        1,
                        NOW(),
                        v_unit_id,
                        v_org_id
                    );

                    v_advice_list := v_advice_list || v_advice_desc || ', ';
                    v_inserted := TRUE;
                END IF;
            END LOOP;

            -- Clean up trailing comma and space
            IF RIGHT(v_advice_list, 2) = ', ' THEN
                v_advice_list := LEFT(v_advice_list, LENGTH(v_advice_list) - 2);
            END IF;

            -- Insert into log table
            INSERT INTO public.t_advice_mapper_fun_log (
                encounter_id, advice_list, status, error_msg
            ) VALUES (
                v_encounter_id, v_advice_list,
                CASE WHEN v_inserted THEN 'done' ELSE 'not done' END,
                NULL
            );

            -- Update status in casesheet details table
            UPDATE public.t_patient_casesheet_details
            SET advice_status = 'done'
            WHERE id = rec.id;

        EXCEPTION WHEN OTHERS THEN
            -- Log error and continue
            INSERT INTO public.t_advice_mapper_fun_log (
                encounter_id, advice_list, status, error_msg
            ) VALUES (
                v_encounter_id, v_advice_list, 'error', SQLERRM
            );
        END;
    END LOOP;
END;
$function$
;



