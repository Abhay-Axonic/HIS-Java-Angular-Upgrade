--CALLING ALL FUNCTION
CREATE TABLE public.t_full_casesheet_fun_log (
	log_id serial4 NOT NULL,
	encounter_id int4 NULL,
	status text NULL,
	error_msg text NULL,
	processed_at timestamp DEFAULT now() NULL,
	CONSTRAINT t_full_casesheet_fun_log_pkey PRIMARY KEY (log_id)
);

--DROP FUNCTION IF EXISTS process_full_casesheet_by_encounter(INT);

CREATE OR REPLACE FUNCTION process_full_casesheet_by_encounter(p_encounter_id INT DEFAULT NULL)
RETURNS VOID AS $$
DECLARE
    rec RECORD;
    v_found BOOLEAN := FALSE;
    v_status TEXT;
    v_error_msg TEXT;
    v_updated_count INT;
BEGIN
    FOR rec IN
        SELECT encounter_id, patient_map_status
        FROM public.t_patient_casesheet_details
        WHERE 
            (
                p_encounter_id IS NULL AND (patient_map_status IS NULL OR patient_map_status != 'done')
            )
            OR 
            (p_encounter_id IS NOT NULL AND encounter_id = p_encounter_id)
    LOOP
        v_found := TRUE;

        BEGIN
            -- Skip if already marked done
            IF rec.patient_map_status = 'done' THEN
                CONTINUE;
            END IF;

            -- Call processing functions
            PERFORM process_advice_by_encounter(rec.encounter_id);
            PERFORM process_family_history(rec.encounter_id);
            PERFORM process_medical_history_by_encounter(rec.encounter_id);
            PERFORM process_diagnosis_by_encounter(rec.encounter_id);
            PERFORM process_complaints_by_encounter(rec.encounter_id);
            PERFORM process_casesheet_vitals(rec.encounter_id);
            PERFORM process_allergy_by_encounter(rec.encounter_id);
            PERFORM process_habit_by_encounter(rec.encounter_id);

            -- Mark as done
            UPDATE public.t_patient_casesheet_details
            SET patient_map_status = 'done', updated_date = now()
            WHERE encounter_id = rec.encounter_id;

            GET DIAGNOSTICS v_updated_count = ROW_COUNT;

            IF v_updated_count > 0 THEN
                v_status := 'done';
                v_error_msg := NULL;
            ELSE
                v_status := 'skipped';
                v_error_msg := 'Already processed or not updated';
            END IF;

        EXCEPTION WHEN OTHERS THEN
            v_status := 'error';
            v_error_msg := SQLERRM;
        END;

        -- Always log
        INSERT INTO public.t_full_casesheet_fun_log(
            encounter_id, status, error_msg
        ) VALUES (
            rec.encounter_id, v_status, v_error_msg
        );
    END LOOP;

    -- If no matching record at all
    IF NOT v_found THEN
        INSERT INTO public.t_full_casesheet_fun_log(
            encounter_id, status, error_msg
        ) VALUES (
            p_encounter_id, 'error', 'No matching encounter_id found or all already processed'
        );
    END IF;
END;
$$ LANGUAGE plpgsql;


