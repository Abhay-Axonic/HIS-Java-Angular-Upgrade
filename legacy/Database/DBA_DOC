-- DROP FUNCTION public.process_allergy_by_encounter(int4);

CREATE OR REPLACE FUNCTION public.process_allergy_by_encounter(p_encounter_id integer DEFAULT NULL::integer)
 RETURNS void
 LANGUAGE plpgsql
AS $function$
DECLARE
    rec RECORD;
    v_json JSONB;
    v_allergy JSONB;
    v_allergy_name TEXT;
    v_allergy_type_name TEXT;
    v_severity_desc TEXT;
    v_remark TEXT;
    v_allergy_id INT;
    v_severity_id INT;
    v_patient_id INT;
    v_admission_id INT := NULL;
    v_appointment_id INT := NULL;
    v_unit_id INT;
    v_org_id INT;
    v_allergy_type_id INT;
    v_allergy_ids TEXT := '';
    v_inserted BOOLEAN := FALSE;
BEGIN
    FOR rec IN
        SELECT * FROM public.t_patient_casesheet_details
        WHERE (p_encounter_id IS NULL AND (patient_map_status IS NULL OR patient_map_status != 'done'))
           OR (p_encounter_id IS NOT NULL AND encounter_id = p_encounter_id)
    LOOP
        BEGIN
            v_json := rec.json_message::jsonb;
            v_unit_id := rec.unit_id;
            v_org_id := rec.org_id;

            IF jsonb_typeof(v_json->'allergy') != 'array' OR jsonb_array_length(v_json->'allergy') = 0 THEN
                CONTINUE;
            END IF;

            -- Get patient and appointment info
            SELECT tem.patient_id, tem.appointment_id INTO v_patient_id, v_appointment_id
            FROM opd.t_encounter_master tem
            WHERE tem.encounter_id = rec.encounter_id;

            -- Optional admission id
            SELECT ta.admission_id INTO v_admission_id
            FROM adt.t_admission ta
            WHERE ta.patient_id = v_patient_id
            ORDER BY ta.admission_id DESC
            LIMIT 1;

            -- Process allergies
            FOR v_allergy IN SELECT * FROM jsonb_array_elements(v_json -> 'allergy')
            LOOP
                v_allergy_name := TRIM(LOWER(v_allergy->>'allergyName'));
                v_allergy_type_name := TRIM(LOWER(v_allergy->>'allergyTypeName'));
                v_severity_desc := TRIM(LOWER(v_allergy->>'severityDesc'));
                v_remark := v_allergy->>'remark';

                -- Step 1: Lookup or insert allergy_type_id
                SELECT matm.allergy_type_id INTO v_allergy_type_id
                FROM emr.m_allergy_type_master matm
                WHERE TRIM(LOWER(matm.allergy_type_name)) = v_allergy_type_name
                LIMIT 1;

                IF v_allergy_type_id IS NULL THEN
                    INSERT INTO emr.m_allergy_type_master (
                        allergy_type_name, created_by, created_date, updated_by, updated_date, status,
                        allergy_type_desc, marathi_allergy_type_name, unit_id, organization_id, is_generic
                    )
                    VALUES (
                        INITCAP(v_allergy_type_name), 1, now(), 1, now(), 'A',
                        INITCAP(v_allergy_type_name), NULL, v_unit_id, v_org_id, 'N'
                    )
                    RETURNING allergy_type_id INTO v_allergy_type_id;
                END IF;

                -- Step 2: Lookup or insert allergy_id
                SELECT mam.allergy_id INTO v_allergy_id
                FROM emr.m_allergy_master mam
                WHERE TRIM(LOWER(mam.allergy_name)) = v_allergy_name
                LIMIT 1;

                IF v_allergy_id IS NULL THEN
                    INSERT INTO emr.m_allergy_master (
                        allergy_name, status, created_by, created_date, updated_by, updated_date,
                        allergy_type_id, unit_id, organization_id
                    )
                    VALUES (
                        INITCAP(v_allergy_name), 'A', 1, now(), 1, now(),
                        v_allergy_type_id, v_unit_id, v_org_id
                    )
                    RETURNING allergy_id INTO v_allergy_id;
                END IF;

                -- Step 3: Lookup severity_id
                SELECT msm.severity_id INTO v_severity_id
                FROM emr.m_severity_master msm
                WHERE TRIM(LOWER(msm.severity_desc)) = v_severity_desc
                LIMIT 1;

                -- Step 4: Insert into patient.t_allergy_patient_mapper
                INSERT INTO patient.t_allergy_patient_mapper (
                    allergy_id, patient_id, type, nature_of_reaction, comments, severity_id, remark,
                    allergy_type_id, created_by, created_date, updated_by, updated_date,
                    status, month, year, is_no_known_allergies, unit_id, organization_id,
                    encounter_id, admission_id
                ) VALUES (
                    v_allergy_id, v_patient_id, '20', NULL, '', v_severity_id, v_remark,
                    v_allergy_type_id, 1, now(), 1, now(),
                    'A', NULL, NULL, 'N', v_unit_id, v_org_id,
                    rec.encounter_id, v_admission_id
                );

                v_allergy_ids := v_allergy_ids || v_allergy_id || ',';
                v_inserted := TRUE;
            END LOOP;

            -- Clean up trailing comma
            IF RIGHT(v_allergy_ids, 1) = ',' THEN
                v_allergy_ids := LEFT(v_allergy_ids, LENGTH(v_allergy_ids) - 1);
            END IF;

            -- Insert into log
            INSERT INTO public.t_allergy_mapper_fun_log (
                encounter_id, allergy_ids, status, error_msg
            ) VALUES (
                rec.encounter_id, v_allergy_ids, 
                CASE WHEN v_inserted THEN 'done' ELSE 'not done' END, NULL
            );

            -- Update source status
            UPDATE public.t_patient_casesheet_details
            SET allergy_status = 'done'
            WHERE id = rec.id;

        EXCEPTION WHEN OTHERS THEN
            INSERT INTO public.t_allergy_mapper_fun_log (
                encounter_id, allergy_ids, status, error_msg
            ) VALUES (
                rec.encounter_id, v_allergy_ids, 'error', SQLERRM
            );
        END;
    END LOOP;
END;
$function$
;





