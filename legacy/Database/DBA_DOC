-- DROP FUNCTION public.process_casesheet_vitals(int4);

CREATE OR REPLACE FUNCTION public.process_casesheet_vitals(p_encounter_id integer DEFAULT NULL::integer)
 RETURNS void
 LANGUAGE plpgsql
AS $function$
DECLARE
    rec RECORD;
    v_json JSONB;
    v_vital JSONB;
    v_vital_name TEXT;
    v_vital_value TEXT;
    v_vital_id INT;
    v_patient_id INT;
    v_admission_id INT := NULL;
    v_inserted BOOLEAN;
    v_vital_ids TEXT := '';
BEGIN
    FOR rec IN
        SELECT * FROM public.t_patient_casesheet_details
        WHERE (p_encounter_id IS NULL AND (patient_map_status IS NULL OR patient_map_status != 'done'))
           OR (p_encounter_id IS NOT NULL AND encounter_id = p_encounter_id)
    LOOP
        v_inserted := FALSE;
        v_vital_ids := '';
 
        v_json := rec.json_message::jsonb;
 
        SELECT tem.patient_id INTO v_patient_id
        FROM opd.t_encounter_master tem
        WHERE tem.encounter_id = rec.encounter_id;
 
        SELECT ta.admission_id INTO v_admission_id
        FROM adt.t_admission ta
        WHERE ta.patient_id = v_patient_id
        ORDER BY ta.admission_id DESC
        LIMIT 1;
 
        FOR v_vital IN
            SELECT * FROM jsonb_array_elements(v_json -> 'vitals')
        LOOP
            v_vital_name := TRIM(LOWER(v_vital ->> 'vitalName'));
            v_vital_value := v_vital ->> 'value';
 
            SELECT mvm.vital_id INTO v_vital_id
            FROM emr.m_vital_master mvm
            WHERE TRIM(LOWER(mvm.vital_name)) = v_vital_name
            LIMIT 1;
 
            IF v_vital_id IS NOT NULL THEN
                INSERT INTO patient.t_appointment_vital_mapper (
                    vital_id, value, status, created_by, created_date, is_self_triage,
                    patient_id, updated_by, updated_date,
                    unit_id, organization_id, encounter_id, role_id, is_reviewed_flag,
                    admission_id, is_entered_in_error, is_post_facto, post_facto_time, post_facto_date
                )
                VALUES (
                    v_vital_id, v_vital_value, 'A', 1, NOW(), 'I',
                    v_patient_id, 1, NOW(),
                    rec.unit_id, rec.org_id, rec.encounter_id, 2, 'N',
                    v_admission_id, 'N', 'N', CURRENT_TIME::time, CURRENT_DATE
                );
 
                -- Track inserted vital_ids
                v_vital_ids := v_vital_ids || v_vital_id || ',';
                v_inserted := TRUE;
            END IF;
        END LOOP;
 
        -- Remove trailing comma
        IF RIGHT(v_vital_ids, 1) = ',' THEN
            v_vital_ids := LEFT(v_vital_ids, LENGTH(v_vital_ids) - 1);
        END IF;
 
        -- Update status in source table
        UPDATE public.t_patient_casesheet_details
        SET vital_status = CASE WHEN v_inserted THEN 'done' ELSE 'not done' END
        WHERE id = rec.id;
 
        -- Insert into log table
        INSERT INTO public.t_vital_mapper_fun_log(encounter_id, vital_ids, status)
        VALUES (rec.encounter_id, v_vital_ids, CASE WHEN v_inserted THEN 'done' ELSE 'not done' END);
    END LOOP;
END;
$function$
;



