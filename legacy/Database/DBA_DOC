-- DROP FUNCTION public.process_family_history(int8);

CREATE OR REPLACE FUNCTION public.process_family_history(p_encounter_id bigint DEFAULT NULL::bigint)
 RETURNS void
 LANGUAGE plpgsql
AS $function$
DECLARE
    rec RECORD;
    v_json JSONB;
    v_item JSONB;
    v_encounter_id INT;
    v_patient_id INT;
    v_unit_id INT;
    v_org_id INT;
    v_admission_id INT := NULL;
    v_relation_name TEXT;
    v_relation_id INT;
    v_diag_code TEXT;
    v_diag_name TEXT;
    v_diag_desc TEXT;
    v_diag_id INT;
    v_remark TEXT;
    v_inserted BOOLEAN := FALSE;
    v_list TEXT := '';
BEGIN
    FOR rec IN
        SELECT * FROM public.t_patient_casesheet_details
        WHERE (p_encounter_id IS NULL AND (family_history_status IS NULL OR family_history_status != 'done'))
           OR (p_encounter_id IS NOT NULL AND encounter_id = p_encounter_id)
    LOOP
        BEGIN
            v_json := rec.json_message::jsonb;
            v_encounter_id := rec.encounter_id;
            v_unit_id := rec.unit_id;
            v_org_id := rec.org_id;

            -- Get patient ID from encounter
            SELECT tem.patient_id INTO v_patient_id
            FROM opd.t_encounter_master tem
            WHERE tem.encounter_id = v_encounter_id;

            -- Get admission ID if available
            SELECT ta.admission_id INTO v_admission_id
            FROM adt.t_admission ta
            WHERE ta.patient_id = v_patient_id
            ORDER BY ta.admission_id DESC LIMIT 1;

            -- Loop through familyHistory array
            FOR v_item IN SELECT * FROM jsonb_array_elements(v_json -> 'familyHistory')
            LOOP
                v_diag_code := TRIM(v_item->>'code');
                v_diag_name := TRIM(v_item->>'diagnosisDesc');
                v_diag_desc := v_diag_name;
                v_relation_name := TRIM(v_item->>'relationDesc');
                v_remark := NULLIF(TRIM(v_item->>'remark'), '');

                -- Get or insert relation
                SELECT relation_id INTO v_relation_id
                FROM public.m_relation_master
                WHERE LOWER(relation_name) = LOWER(v_relation_name)
                LIMIT 1;

                IF v_relation_id IS NULL THEN
                    INSERT INTO public.m_relation_master (
                        relation_code, relation_name, created_by, created_date, status,
                        updated_by, updated_date, organization_id
                    ) VALUES (
                        LEFT(UPPER(v_relation_name), 3), INITCAP(v_relation_name), 1, NOW(), 'A',
                        1, NOW(), v_org_id
                    ) RETURNING relation_id INTO v_relation_id;
                END IF;

                -- Get or insert diagnosis
                SELECT diagnosis_id INTO v_diag_id
                FROM emr.m_diagnosis_master
                WHERE code = v_diag_code
                LIMIT 1;

                IF v_diag_id IS NULL THEN
                    INSERT INTO emr.m_diagnosis_master (
                        diagnosis_desc, diagnosis_name, status, created_date,
                        created_by, code, updated_by, updated_date, unit_id, organization_id,
                        is_notifiable, is_comorbidity
                    ) VALUES (
                        v_diag_desc, v_diag_name, 'A', NOW(),
                        1, v_diag_code, 1, NOW(), v_unit_id, v_org_id,
                        'N', 'N'
                    ) RETURNING diagnosis_id INTO v_diag_id;
                END IF;

                -- Insert into t_family_history
                INSERT INTO patient.t_family_history (
                    relation_id, diagnosis_id, status, remark, created_by, created_date,
                    updated_by, updated_date, unit_id, organization_id,
                    is_no_family_history_status, patient_id, encounter_id, role_id,
                    is_reviewed_flag, is_enter_in_error, admission_id, cov_template_id
                ) VALUES (
                    v_relation_id, v_diag_id, 'A', v_remark, 1, NOW(),
                    1, NOW(), v_unit_id, v_org_id,
                    'N', v_patient_id, v_encounter_id, 2,
                    'N', 'N', v_admission_id, NULL
                );

                v_list := v_list || v_relation_name || '-' || v_diag_name || ', ';
                v_inserted := TRUE;
            END LOOP;

            -- Clean up trailing comma
            IF RIGHT(v_list, 2) = ', ' THEN
                v_list := LEFT(v_list, LENGTH(v_list) - 2);
            END IF;

            -- Insert log
            INSERT INTO public.t_family_history_fun_log (
                encounter_id, family_history_list, status, error_msg
            ) VALUES (
                v_encounter_id, v_list,
                CASE WHEN v_inserted THEN 'done' ELSE 'not done' END,
                NULL
            );

            -- Update status
            UPDATE public.t_patient_casesheet_details
            SET family_history_status = 'done'
            WHERE id = rec.id;

        EXCEPTION WHEN OTHERS THEN
            INSERT INTO public.t_family_history_fun_log (
                encounter_id, family_history_list, status, error_msg
            ) VALUES (
                v_encounter_id, v_list, 'error', SQLERRM
            );
        END;
    END LOOP;
END;
$function$
;



