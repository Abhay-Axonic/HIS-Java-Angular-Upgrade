--where date(grn.added_date) = ''2019-12-19''
group by grn.organization_id,grn.unit_id, grn.added_date, pc.category, grn.id, grn.remark, grn.invoice_number
order by grn.id)
union All
(select  distinct(grn.id), ''Purchase'' as voucherType, vendor."name"::character varying(255) as Ledger,  grn.added_date as transactionDate, 0::double precision as debitNote,
(grn.net_amount + grn.round_off)  as creditNote, grn.remark, grn.unit_id, grn.organization_id, grn.invoice_number,''Purchase'' as tran_type
from procurement.t_good_receipt_note_detail grnd
inner join procurement.t_good_receipt_note grn on grn.id = grnd.grn_id
