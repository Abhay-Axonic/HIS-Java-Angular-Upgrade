            							WHERE  (d.updated_date::DATE>=p_date OR d.created_date::DATE>=p_date)
												AND d.status = ''A'')
										AND d.status = ''A''
				GROUP BY 	d.unit_id ,
							d.organization_id,
							d.discharge_date :: DATE ,
							a.speciality_id ,
							d.doctor_id,
							ca.diagnosis_id,
							d.status;
 
END;

';


