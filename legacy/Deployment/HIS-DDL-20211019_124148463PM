-- Name: create_contrainsts(text, text, text, text); Type: PROCEDURE; Schema: public; Owner: -
--

CREATE PROCEDURE public.create_contrainsts(db_name text, ids text, inputtablename text, table_key text)
    LANGUAGE plpgsql
    AS ' declare
row record;
begin for row in
select
distinct concat(sch.table_schema, ''.'', sch.table_name) as tablename,
sch.table_name as tablen,
col.column_name as colname,
(select count(distinct tc.constraint_name)
from
information_schema.table_constraints as tc
join information_schema.key_column_usage as kcu on
tc.constraint_name = kcu.constraint_name
join information_schema.constraint_column_usage as ccu on
ccu.constraint_name = tc.constraint_name
where
tc.constraint_type = ''FOREIGN KEY''
and tc.table_name = sch.table_name
and kcu.column_name = any ( string_to_array(ids, '',''))) as ct
from
information_schema.tables sch
inner join information_schema.columns col on
sch.table_name = col.table_name
and sch.table_schema  =col.table_schema
where
sch.table_catalog = db_name
and sch.table_schema not in (''information_schema'',
''pg_catalog'',''Reports'')
and sch.table_type = ''BASE TABLE''
and col.column_name = any (string_to_array(ids, '',''))
loop execute
case when row.ct=0
then ''ALTER TABLE '' || row.tablename || '' ADD CONSTRAINT '' || row.tablen || ''_''||table_key||''_fkey'' || '' FOREIGN KEY (''|| row.colname ||'') REFERENCES ''||inputtablename||''(''||table_key||'');''
else '''' end;
end loop;
end;
';


