 (select  grn.id, ''Purchase'' as voucherType, pc.category::character varying(255) as Ledger,  grn.added_date as transactionDate, sum(grnd.total_amount-grn.total_discount) as debitNote,
 0::double precision as creditNote, grn.remark, grn.unit_id, grn.organization_id, grn.invoice_number,''Purchase'' as tran_type
from procurement.t_good_receipt_note_detail grnd
inner join procurement.t_good_receipt_note grn on grn.id = grnd.grn_id
inner join public.m_item item on item.id = grnd.item_id
inner join public.m_generic generic on generic.id = item.generic_id
