    LANGUAGE plpgsql
    AS '

DECLARE
BEGIN
 RETURN QUERY 	Select 		am.appointment_id,
							am.unit_id,
							am.organization_id as hospital_id,
							sm.appointment_date ,
							em.doctor_id ,
