CREATE FUNCTION public.discid(aid integer) RETURNS timestamp without time zone
    LANGUAGE plpgsql
    AS '
declare param_date timestamp;
begin	
select created_date into param_date from 
(select discharge_id,discharge_date,created_date,discharge_type_id,discharge_status_id,status from adt.t_discharge 
where admission_id=aid and status=''A''
order by discharge_id asc limit 1) as disid
order by discharge_id limit 1;
return param_date;
end;
';


