--

CREATE FUNCTION public.collection_sms(todays_date text, unit integer) RETURNS TABLE(self_adm_count bigint, credit_adm_count bigint, self_dis_count bigint, credit_dis_count bigint, new_visit_count bigint, follow_up_visit_count bigint, deth_count bigint, total_amt numeric, refund_amt numeric, deposit_amt numeric)
    LANGUAGE plpgsql
    AS ' declare begin return QUERY
select
	(
	select
		count(adm.admission_id)
	from
		opd.t_patient_sponsor_details psd
	inner join adt.t_admission adm on
		adm.admission_id = psd.admission_id
	where
		psd.admission_id is not null
		and psd.unit_id = unit
		and psd.priority_id = 1
		and psd.payee_id = (
		select
			self_payee_id
		from
			t_unit_application_billing_configuration tuabc
		where
			unit_id = unit
			and status = ''A''
		limit 1)
		and to_char (adm.created_date,
		''yyyy-mm-dd'')= todays_date
		and adm.status = ''A'')as self_adm_count,
	(
	select
		count(adm.admission_id)
	from
		opd.t_patient_sponsor_details psd
	inner join adt.t_admission adm on
		adm.admission_id = psd.admission_id
	where
		psd.admission_id is not null
		and psd.priority_id = 1
		and psd.unit_id = unit
		and psd.payee_id != (
		select
			self_payee_id
		from
			t_unit_application_billing_configuration tuabc
		where
			unit_id = unit
			and status = ''A''
		limit 1)
		and to_char (adm.created_date,
		''yyyy-mm-dd'') = todays_date
			and adm.status = ''A'') as credit_adm_count,
	(
	select
		count(adm.admission_id)
	from
		opd.t_patient_sponsor_details psd
	inner join adt.t_admission adm on
		adm.admission_id = psd.admission_id
	inner join adt.t_discharge dis on
		dis.admission_id = adm.admission_id
	where
		psd.admission_id is not null
		and psd.priority_id = 1
		and psd.payee_id = (
		select
			self_payee_id
		from
			t_unit_application_billing_configuration tuabc
		where
			unit_id = unit
			and status = ''A''
		limit 1)
		and psd.unit_id = unit
		and to_char (dis.created_date,
		''yyyy-mm-dd'') = todays_date
			and dis.discharge_status_id = 5)as self_dis_count,
	(
	select
		count(adm.admission_id)
	from
		opd.t_patient_sponsor_details psd
	inner join adt.t_admission adm on
		adm.admission_id = psd.admission_id
	inner join adt.t_discharge dis on
		dis.admission_id = adm.admission_id
	where
		psd.admission_id is not null
		and psd.priority_id = 1
		and psd.payee_id != (
		select
			self_payee_id
		from
			t_unit_application_billing_configuration tuabc
		where
			unit_id = unit
			and status = ''A''
		limit 1)
		and psd.unit_id = unit
		and to_char (dis.created_date,
		''yyyy-mm-dd'') = todays_date
			and dis.discharge_status_id = 5)as creditDisCount,
	(
	select
		count(encounter_id)
	from
		opd.t_encounter_master
	where
		user_defined_visit_type_id = 1
		and unit_id = unit
		and to_char(created_date, ''yyyy-mm-dd'') = todays_date )as newVisitCount,
	(
	select
		count(encounter_id)
	from
		opd.t_encounter_master
	where
		user_defined_visit_type_id != 1
		and unit_id = unit
		and to_char(created_date, ''yyyy-mm-dd'') = todays_date ) as followUpVisitCount,
	(
	select
		count(admission_id)
	from
		adt.t_discharge
	where
		discharge_type_id = 3
		and unit_id = unit
		and status = ''A''
		and discharge_status_id = 5
		and to_char(created_date, ''yyyy-mm-dd'') = todays_date)as dethCount,
	(
	select
		SUM(amount) as total_amt
	from
		(
		select
			coalesce(cast(sum(prm.amount) as numeric(10, 2)), 0)as amount
		from
			billing.t_payment_reciept_master prm
		where
			to_char(prm.date_of_reciept, ''yyyy-mm-dd'')= todays_date
				and prm.unit_id = unit
		union all
			select
				coalesce(cast(sum(ts.amount) as numeric(10, 2)), 0)as amount
			from
				pharmacy.t_sale_payment_mode ts
			where
				to_char(ts.added_date, ''yyyy-mm-dd'')= todays_date
					and is_active = true
					and is_deleted = false
					and ts.unit_id = unit ) x )as total_amt,
	(
	select
		coalesce(cast(sum(prm.amount_refunded) as numeric(10, 2)), 0)
	from
		billing.t_payment_refund_master prm
	where
		to_char(prm.created_date, ''yyyy-mm-dd'')= todays_date
			and prm.unit_id = unit) as refund_amt,
	(
	select
		coalesce(cast(sum(dp.deposit_amount) as numeric(10, 2)), 0)
	from
		billing.m_deposit_master dp
	where
		to_char(dp.created_date, ''yyyy-mm-dd'')= todays_date
			and dp.unit_id = unit ) as deposit_amt ;
end;

';


