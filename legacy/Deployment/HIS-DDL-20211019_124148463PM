(select ''Sales Return'' as ledger,salesreturndetail.return_id as id, ''Return'' as voucherType, salesreturn.added_date as transactionDate,
0::double precision as debitNote, sum(salesreturndetail.return_amt) as creditNote,salesreturn.unit_id, salesreturn.organization_id, '''' as VouNarration,'''' as bankName
from pharmacy.t_return_detail salesreturndetail
inner join pharmacy.t_return  salesreturn on salesreturn.id = salesreturndetail.return_id
inner join pharmacy.t_sale_detail salesdetails on salesreturndetail.sale_detail_id = salesdetails.id
inner join inventory.t_batch batch on batch.id = salesdetails.batch_id
inner join public.m_item item on item.id = batch.item_id
inner join public.m_generic generic on generic.id = item.generic_id
inner join public.m_product_category pc on pc.id = generic.product_category_id
group by  salesreturndetail.return_id, pc.category , salesreturn.added_date, salesreturn.unit_id, salesreturn.organization_id)

union all

(select ''Pharmacy Sales Return'' as ledger,salesreturndetail.return_id as id, ''Return'' as voucherType, salesreturn.added_date as transactionDate,
sum(salesreturndetail.return_amt) as debitNote, 0::double precision as creditNote, salesreturn.unit_id, salesreturn.organization_id ,'''' as VouNarration,'''' as bankName
from pharmacy.t_return_detail salesreturndetail
inner join pharmacy.t_return  salesreturn on salesreturn.id = salesreturndetail.return_id
inner join pharmacy.t_sale_detail salesdetails on salesreturndetail.sale_detail_id = salesdetails.id
inner join inventory.t_batch batch on batch.id = salesdetails.batch_id
inner join public.m_item item on item.id = batch.item_id
inner join public.m_generic generic on generic.id = item.generic_id
inner join public.m_product_category pc on pc.id = generic.product_category_id
group by  salesreturndetail.return_id, pc.category , salesreturn.added_date, salesreturn.unit_id, salesreturn.organization_id 
order by salesreturndetail.return_id);
------------Create voucher no
create or replace temporary view	
sale_return_voucher as 
select concat(''VOU-'', nextval(''public.tally_voucher_no_seq'')) as voucher, salesreturn.transactionDate
from salesreturn
group by salesreturn.transactionDate;

insert into public.t_tally_interface
(voucher_no, voucher_type, ledger, voucher_date,debit_amount, credit_amount, vou_narration, unit_id, hospital_id, tran_type, bank_name)
select scv.voucher, ''SaleReturn'' as voucherType, sc.ledger, sc.transactionDate, sc.debitNote, sc.creditNote, sc.VouNarration as voucherNarration
, sc.unit_id, sc.organization_id, ''SalesReturn'' as tran_type, sc.bankName
from salesreturn sc
join sale_return_voucher scv on sc.transactionDate = scv.transactionDate
where date(sc.transactionDate) =  dateoftrans
order by sc.transactionDate, scv.transactionDate;

return true;
EXCEPTION 
 when OTHERS then 
	return false;

end;
';


--
-- TOC entry 4023 (class 1255 OID 3517544)
-- Name: post_visit_fa_data(timestamp without time zone); Type: FUNCTION; Schema: public; Owner: -
--

CREATE FUNCTION public.post_visit_fa_data(dateoftrans timestamp without time zone) RETURNS boolean
    LANGUAGE plpgsql
    AS '
declare voucherno integer = nextval(''public.tally_voucher_no_seq'');
declare nextVoucherno integer = nextval(''public.tally_voucher_no_seq'');

declare voucherno_ip integer = nextval(''public.tally_voucher_no_seq'');
declare nextVoucherno_ip integer = nextval(''public.tally_voucher_no_seq'');

begin 

------<----1. OP---------------	
	
	
	----------- Create view ---------------------------
create or replace temporary view 
  opbill
AS
	(select pMode.payment_mode_id as modeid, pMode.payment_mode_desc as mode,  pReceiptDtls.amount  as rcptamount, 
	billMst.outstanding as outstanding, billMst.net_amount as billnetamount, bank.bank_name as bankname, 
	pReceiptDtls.card_number as cardnumber, pReceiptDtls.card_type_id as cardtypeid, 
	pReceiptDtls.check_number as chequenumber, pReceiptDtls.cheque_date::date as chequedate, 
	pReceiptDtls.transaction_no as transactionno, pReceiptDtls.payment_reciept_details_id as paymentreceiptdetailId,
	billMst.organisation_id as orgid, billMst.unit_id as unitid,
	pReceiptDtls.date_of_transaction :: date as transdate, billMst.bill_date_time :: date as billdate,
	pReceiptDtls.trans_transaction_date as transferdate
	from billing.t_payment_reciept_details pReceiptDtls
	inner join public.m_payment_mode_master  pMode on pMode.payment_mode_id = pReceiptDtls.payment_mode_id
	inner join billing.t_payment_reciept_master pReceiptMst on pReceiptMst.payment_reciept_id = pReceiptDtls.payment_receipt_master_id 
	inner join billing.m_billing_master billMst on pReceiptMst.billing_master_id = billMst.billing_master_id
	left join billing.m_bank_master bank on bank.bank_id = pReceiptDtls.bank_id
	where  billMst.visit_type_id = 1);

------- Insert cash start ---------------
insert into public.t_tally_interface
(voucher_no, voucher_type, ledger, voucher_date,debit_amount, credit_amount, unit_id, hospital_id,tran_type)
select voucherno, ''Sales'', opbill.mode,  opbill.transdate, cast(sum(opbill.rcptamount) as numeric(10,2)), 0 , opbill.unitId, opbill.orgId , ''OP''
from opbill
where  opbill.transdate = opbill.billdate and opbill.modeid = 1 and opbill.transdate = dateoftrans--cash
group by opbill.modeid, opbill.transdate, opbill.orgid,opbill.unitid,opbill.mode;
------- Insert cash end ---------------

------- Insert others start where transaction-date = bill-date---------------
insert into public.t_tally_interface
(voucher_no, voucher_type, ledger, voucher_date,debit_amount, credit_amount, unit_id, hospital_id,unique_number,
instrument_date,tran_type,bank_name,instrument_number)
select voucherno, ''Sales'', 
opbill.mode,  opbill.transdate,   cast(opbill.rcptamount as numeric(10,2)), 0 , opbill.unitId, opbill.orgId, opbill.paymentreceiptdetailId,
coalesce(opbill.chequedate,opbill.transferdate),  ''OP'', opbill.bankname, 
coalesce(opbill.chequenumber,opbill.cardnumber,opbill.transactionno)
from opbill
where  opbill.transdate= opbill.billdate and opbill.modeid <> 1 and opbill.transdate = dateoftrans;
------- Insert others start--------------- 

with roundoff as (select sum(bm.round_off) as round_off_amount,bm.unit_id as unitId,bm.organisation_id as orgId,bm.created_date::date as transactionDate from billing.m_billing_master bm 
	where bm.created_date::date = dateoftrans and bm.visit_type_id = 1 
	group by bm.organisation_id,bm.unit_id,bm.created_date::date 
	having sum(bm.round_off) is not null) 
	
		insert
			into
				public.t_tally_interface (voucher_no,
				voucher_type,
				ledger,
				voucher_date,
				debit_amount,
				credit_amount,
				unit_id,
				hospital_id,
				tran_type) select
					voucherno,
					''Sales'',
					''Discount round-off'',
					roundoff.transactionDate,
					case 
					when roundoff.round_off_amount<0 then 
					cast(-roundoff.round_off_amount as numeric(10, 2)) 
						else 
					0 end,
					case 
					when roundoff.round_off_amount>0 then 
					cast(roundoff.round_off_amount as numeric(10, 2)) 
						else 0
					 end ,
					roundoff.unitId,
					roundoff.orgId,
					''OP''
				from
					roundoff
				where roundoff.round_off_amount >0 or roundoff.round_off_amount <0 ;

---------------------- Company amount --------------------------------
with comp as (
	select mpr.payee_id as ledgerId,
	comp.company_desc as ledger,
	sum(mpr.payee_amount) as amount,
	billDtls.created_date::date as transactionDate,
	billMst.organisation_id as orgId,
	billMst.unit_id as unitId
from
	billing.t_bill_details_payee_mapper mpr
inner join billing.t_billing_details billDtls on
	mpr.bill_details_id = billDtls.billing_details_id
inner join billing.m_billing_master billMst on
	billMst.billing_master_id = billDtls.billing_master_id
inner join public.t_company_master comp on
	comp.company_id = mpr.payee_id
where
	billDtls.created_date::date = dateoftrans
	and billMst.visit_type_id = 1
	and mpr.status=''A''
	and mpr.payee_id <> (
		select self_payee_id
	from
		t_unit_application_billing_configuration
	where
		unit_id = billMst.unit_id
		and status = ''A'')
group by
	mpr.payee_id,
	comp.company_desc,
	billDtls.created_date::date,
	billMst.organisation_id,
	billMst.unit_id) insert
	into
		public.t_tally_interface (voucher_no,
		voucher_type,
		ledger,
		voucher_date,
		debit_amount,
		credit_amount,
		unit_id,
		hospital_id,
		tran_type) select
			voucherno,
			''Sales'',
			comp.ledger,
			comp.transactionDate,
			cast(comp.amount as numeric(10, 2)),
			0,
			comp.unitId,
			comp.orgId,
			''OP''
		from
			comp;

------------------------------Package consumption ---------------------------------
with pack as (select genLedMst.general_ledger_id, genLedMst.general_ledger_name as ledger, sum(dtls.gross_amount) as amount , 
bill.organisation_id as orgId, bill.unit_id as unitId, dtls.created_date::date as createdDate
from billing.t_billing_details dtls 
inner join billing.m_billing_master bill on bill.billing_master_id = dtls.billing_master_id
inner join service.m_service_master servMst on servMst.service_master_id = dtls.service_id
inner join doctor.m_speciality_master spc on spc.speciality_id = servMst.speciality_id
inner join public.m_general_ledger_master genLedMst on genLedMst.general_ledger_id = spc.general_ledger_id
inner join public.t_order_details ordt on ordt.order_details_id = dtls.order_details_id
where dtls.created_date::date = dateoftrans and  bill.visit_type_id = 1 and ordt.is_package_service = ''Y''
group by genLedMSt.general_ledger_id,genLedMst.general_ledger_name, dtls.created_date::date, bill.organisation_id, bill.unit_id)
insert into public.t_tally_interface
(voucher_no, voucher_type, ledger, voucher_date,debit_amount, credit_amount, unit_id, hospital_id,tran_type)
select voucherno, ''Sales'',pack.ledger, pack.createdDate, cast(pack.amount as numeric(10,2)), 0, pack.unitId, pack.orgId, ''OP'' from pack;
--------------------------------------------------
-------------------- Insert deposit consumption --------------------------------------
insert into public.t_tally_interface
(voucher_no, voucher_type, ledger, voucher_date,debit_amount, credit_amount, unit_id, hospital_id,tran_type)
select voucherno, ''Sales'', ''Patient Advance'', pdc.created_date::date, cast(sum(pdc.consumed_amount) as numeric(10,2)), 0, pdc.unit_id, pdc.organization_id,''OP''
from billing.t_payment_deposite_consumption_details pdc
inner join billing.t_payment_deposite_consumption pd
on pd.dep_consumption_id = pdc.dep_consumption_id
inner join billing.m_billing_master bill
on bill.billing_master_id = pd.bill_id
where pdc.created_date::date = dateoftrans and bill.visit_type_id = 1
group by  pdc.organization_id, pdc.unit_id,pdc.created_date::date;

-------------------xxx-------------------------------------
------- Insert outstanding start---------------
with outst as (select sum(bill.net_amount) as amount, coalesce(sum(bill.outstanding),0) as outstanding, 
bill.organisation_id as orgId, bill.unit_id as unitId, bill.bill_date_time::date as billDate
from billing.m_billing_master bill
where bill.bill_date_time::date = dateoftrans and bill.visit_type_id = 1
group by bill.organisation_id, bill.unit_id, bill.bill_date_time::date)
/*cred as (select coalesce(sum (billdt.credit_payable),0) as creditPayable, billdt.organization_id as orgId, billdt.unit_id as unitId
from billing.t_billing_details billdt 
inner join  billing.m_billing_master bill
on bill.billing_master_id = billdt.billing_master_id
where bill.bill_date_time::date = dateoftrans and bill.visit_type_id = 1
group by billdt.organization_id, billdt.unit_id)*/
insert into public.t_tally_interface
(voucher_no, voucher_type, ledger, voucher_date,debit_amount, credit_amount, unit_id, hospital_id,tran_type)
select voucherno, ''Sales'',''Patient Credit'', outst.billDate, cast((outst.outstanding) as numeric(10,2)), 0, outst.unitId, outst.orgId, ''OP'' 
from outst 
where (outst.outstanding) > 0;

------- Insert outstanding end---------------

-------------------- Discount --------------------------
with gen as (	select sum(billMst.discount_amount) as amount,
	billMst.created_date::date as transactionDate,
	billMst.organisation_id as orgId,
	billMst.unit_id as unitId
from
	 billing.m_billing_master billMst
where
	billMst.created_date::date = dateOfTrans
	and billMst.visit_type_id = 1
group by
	billMst.created_date::date,
	billMst.organisation_id,
	billMst.unit_id
having
	sum(billMst.discount_amount) > 0)
insert into public.t_tally_interface
(voucher_no, voucher_type, ledger, voucher_date,debit_amount, credit_amount, unit_id, hospital_id,tran_type)
select voucherno, ''Sales'', ''Discount'', gen.transactionDate, cast(gen.amount as numeric(10,2)), 0, gen.unitId, gen.orgId,''OP'' from gen;
------------------------------------------------
------------ Ledger start -------------------------
with gen as (select genLedMSt.general_ledger_id as ledgerId, genLedMSt.general_ledger_name as ledger,  sum(billDtls.gross_amount) as amount,
billDtls.created_date::date as transactionDate, billMst.organisation_id as orgId, billMst.unit_id as unitId
from billing.t_billing_details billDtls
inner join billing.m_billing_master billMst on billMst.billing_master_id = billDtls.billing_master_id
